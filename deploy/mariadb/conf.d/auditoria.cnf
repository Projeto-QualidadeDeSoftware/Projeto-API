# Auditoria do banco: registra conexões, alterações de estrutura, de dados
# e de permissões (consultas SELECT ficam de fora para o arquivo não crescer demais).
# O arquivo fica em /var/lib/mysql/server_audit.log, com rotação a cada 10 MB.

[mariadb]
plugin_load_add = server_audit
server_audit_logging = ON
server_audit_events = CONNECT,QUERY_DDL,QUERY_DML_NO_SELECT,QUERY_DCL
server_audit_excl_users = monitoramento
server_audit_file_path = server_audit.log
server_audit_file_rotate_size = 10485760
server_audit_file_rotations = 10

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
