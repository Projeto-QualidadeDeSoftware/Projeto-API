# Copie para .env (cp .env.exemplo .env) e preencha. O .env nunca vai para o GitHub.
# Use apenas letras e números nas senhas.

# Endereços (troque 20-0-0-1 pelo IP público da VPS, com traços)
DOMINIO_PRODUCAO=api.20-0-0-1.sslip.io
DOMINIO_HOMOLOGACAO=hml.20-0-0-1.sslip.io
DOMINIO_GRAFANA=grafana.20-0-0-1.sslip.io
DOMINIO_WEB=web.20-0-0-1.sslip.io
DOMINIO_WEB_HOMOLOGACAO=web-hml.20-0-0-1.sslip.io
DOMINIO_MOBILE=mobile.20-0-0-1.sslip.io
DOMINIO_MOBILE_HOMOLOGACAO=mobile-hml.20-0-0-1.sslip.io

# Imagens da API (o deploy automático atualiza estas duas linhas)
IMAGEM_HOMOLOGACAO=ghcr.io/projeto-qualidadedesoftware/projeto-api:latest
IMAGEM_PRODUCAO=ghcr.io/projeto-qualidadedesoftware/projeto-api:latest

# Banco
BANCO_SENHA_ROOT=
BANCO_SENHA_HOMOLOGACAO=
BANCO_SENHA_PRODUCAO=
BANCO_SENHA_MONITORAMENTO=

# Login (JWT_SECRET com pelo menos 32 caracteres, diferente em cada ambiente)
JWT_SECRET_HOMOLOGACAO=
JWT_SECRET_PRODUCAO=
ADMIN_CPF_HOMOLOGACAO=
ADMIN_SENHA_HOMOLOGACAO=
ADMIN_CPF_PRODUCAO=
ADMIN_SENHA_PRODUCAO=

# Fronts (web e versão web do mobile) autorizados a chamar cada API, separados por vírgula
CORS_ORIGENS_HOMOLOGACAO=https://web-hml.20-0-0-1.sslip.io,https://mobile-hml.20-0-0-1.sslip.io
CORS_ORIGENS_PRODUCAO=https://web.20-0-0-1.sslip.io,https://mobile.20-0-0-1.sslip.io

# Assistente de IA
MISTRAL_API_KEY=

# Monitoramento
GRAFANA_SENHA=
